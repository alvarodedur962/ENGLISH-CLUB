<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>English Club - Primary School</title>
  <style>
    /* Estilos Generales */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
      color: #fff;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
    }

    header {
      text-align: center;
      margin-top: 10px;
      margin-bottom: 25px;
    }

    header h1 {
      font-size: 2.2rem;
      color: #ffd700;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
      margin-bottom: 5px;
    }

    header p {
      font-size: 1.1rem;
      opacity: 0.9;
    }

    /* Contenedor Principal */
    .container {
      width: 100%;
      max-width: 600px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    /* Tarjetas de Cursos (3º, 4º, 5º) */
    .grade-card {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border-radius: 16px;
      padding: 20px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
    }

    .grade-title {
      font-size: 1.4rem;
      color: #00e5ff;
      margin-bottom: 15px;
      border-bottom: 2px solid rgba(0, 229, 255, 0.3);
      padding-bottom: 5px;
    }

    .buttons-group {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .btn {
      background: #ff4081;
      color: white;
      border: none;
      padding: 12px 15px;
      border-radius: 10px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
    }

    .btn-games {
      background: #ff9100;
    }

    .btn-worksheets {
      background: #00e676;
      color: #000;
    }

    .btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    }

    .btn:active {
      transform: translateY(0);
    }

    /* Botón Flotante de Settings */
    .settings-toggle {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: #ffd700;
      color: #000;
      width: 55px;
      height: 55px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      cursor: pointer;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
      border: none;
      z-index: 100;
    }

    /* Panel de Ajustes (Modal) */
    .settings-panel {
      position: fixed;
      bottom: 85px;
      right: 20px;
      background: #152238;
      border: 2px solid #ffd700;
      padding: 20px;
      border-radius: 15px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      display: none;
      flex-direction: column;
      gap: 15px;
      width: 260px;
      z-index: 100;
    }

    .settings-panel.active {
      display: flex;
    }

    .settings-panel h3 {
      color: #ffd700;
      font-size: 1.1rem;
      text-align: center;
    }

    .setting-item {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .setting-item label {
      font-size: 0.9rem;
      display: flex;
      justify-content: space-between;
    }

    input[type=range] {
      width: 100%;
      accent-color: #ffd700;
      cursor: pointer;
    }

    .music-btn {
      background: #00e5ff;
      color: #000;
      border: none;
      padding: 8px;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
    }
  </style>
</head>
<body>

  <header>
    <h1>🎓 ENGLISH CLUB 🚀</h1>
    <p>Select your grade and start learning!</p>
  </header>

  <div class="container">
    
    <!-- 3rd Grade -->
    <div class="grade-card">
      <div class="grade-title">⭐ 3rd Grade (3º de Primaria)</div>
      <div class="buttons-group">
        <a href="#" class="btn btn-games" onclick="alert('Cargando Juegos de 3º...')">🎮 Games</a>
        <a href="#" class="btn btn-worksheets" onclick="alert('Cargando Fichas de 3º...')">📄 Worksheets</a>
      </div>
    </div>

    <!-- 4th Grade -->
    <div class="grade-card">
      <div class="grade-title">🌟 4th Grade (4º de Primaria)</div>
      <div class="buttons-group">
        <a href="#" class="btn btn-games" onclick="alert('Cargando Juegos de 4º...')">🎮 Games</a>
        <a href="#" class="btn btn-worksheets" onclick="alert('Cargando Fichas de 4º...')">📄 Worksheets</a>
      </div>
    </div>

    <!-- 5th Grade -->
    <div class="grade-card">
      <div class="grade-title">🚀 5th Grade (5º de Primaria)</div>
      <div class="buttons-group">
        <a href="#" class="btn btn-games" onclick="alert('Cargando Juegos de 5º...')">🎮 Games</a>
        <a href="#" class="btn btn-worksheets" onclick="alert('Cargando Fichas de 5º...')">📄 Worksheets</a>
      </div>
    </div>

  </div>

  <!-- Botón de Ajustes -->
  <button class="settings-toggle" onclick="toggleSettings()" title="Settings">⚙️</button>

  <!-- Panel de Ajustes (Settings) -->
  <div class="settings-panel" id="settingsPanel">
    <h3>⚙️ Settings</h3>
    
    <button class="music-btn" id="musicBtn" onclick="toggleMusic()">▶️ Play Music</button>

    <div class="setting-item">
      <label for="volumeRange">
        <span>🔊 Music Volume</span>
        <span id="volVal">50%</span>
      </label>
      <input type="range" id="volumeRange" min="0" max="100" value="50" oninput="updateVolume(this.value)">
    </div>
  </div>

  <script>
    // Mostrar/Ocultar panel de ajustes
    function toggleSettings() {
      const panel = document.getElementById('settingsPanel');
      panel.classList.toggle('active');
    }

    // --- Reproductor de Música de fondo (8-bit / Motivadora) sintética ---
    let audioCtx = null;
    let isPlaying = false;
    let masterGain = null;
    let timerId = null;

    function initAudio() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        masterGain = audioCtx.createGain();
        masterGain.gain.value = 0.25; // 50% inicial
        masterGain.connect(audioCtx.destination);
      }
    }

    // Melodía motivadora alegre
    const notes = [261.63, 329.63, 392.00, 523.25, 392.00, 329.63, 349.23, 440.00, 523.25, 440.00, 392.00, 329.63];
    let noteIndex = 0;

    function playNote() {
      if (!isPlaying) return;
      
      const osc = audioCtx.createOscillator();
      const noteGain = audioCtx.createGain();

      osc.type = 'triangle'; // Sonido suave y alegre estilo videojuego
      osc.frequency.setValueAtTime(notes[noteIndex], audioCtx.currentTime);

      noteGain.gain.setValueAtTime(0.3, audioCtx.currentTime);
      noteGain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.25);

      osc.connect(noteGain);
      noteGain.connect(masterGain);

      osc.start();
      osc.stop(audioCtx.currentTime + 0.25);

      noteIndex = (noteIndex + 1) % notes.length;
    }

    function toggleMusic() {
      initAudio();
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }

      const btn = document.getElementById('musicBtn');

      if (!isPlaying) {
        isPlaying = true;
        btn.innerText = "⏸️ Pause Music";
        timerId = setInterval(playNote, 300);
      } else {
        isPlaying = false;
        btn.innerText = "▶️ Play Music";
        clearInterval(timerId);
      }
    }

    function updateVolume(val) {
      document.getElementById('volVal').innerText = val + '%';
      if (masterGain) {
        // Ajuste progresivo del volumen
        masterGain.gain.value = (val / 100) * 0.5;
      }
    }
  </script>
</body>
</html>
